#!/bin/sh
# ─────────────────────────────────────────────────────────────
# 아이마디아이 pre-commit 하네스 (버전 관리됨 — 두 PC 동기화 정본)
#   1) 정적 자산 변경 시 sw.js CACHE_NAME 자동 갱신
#   2) 함수 인덱스(FUNCTIONS.md) 자동 재생성  ← 탐색 비용 절감
#   3) 스테이징된 madi-*.js ESLint (XSS no-unsanitized 차단)
#   4) 정적 HTML 박제(.ss-* 런타임 DOM) 차단
#   5) smoke 유닛 테스트
#
# 설치(각 PC 최초 1회):  git config core.hooksPath .githooks
# ─────────────────────────────────────────────────────────────
set -e

TOPLEVEL=$(git rev-parse --show-toplevel 2>/dev/null)
SW_FILE="$TOPLEVEL/sw.js"
STAGED=$(git diff --cached --name-only --diff-filter=ACM)

# ── 1. SW 캐시 버전 갱신 ──────
#   ASSET_CHANGED: 함수인덱스·패턴검사용(sw.js 제외). SW_BUMP: 캐시버전 갱신용(sw.js 포함).
#   sw.js 단독 수정(SKIP_HOSTS·푸시핸들러 등)도 version bump 하여 디바이스 반영 누락을 막고,
#   타임스탬프에 초(%S)를 더해 동일 분 내 2회 커밋 시 버전 충돌(bump 무효)을 방지한다.
ASSET_CHANGED=$(echo "$STAGED" | grep -E '\.(js|css|html)$' | grep -v '^sw\.js$' || true)
SW_BUMP=$(echo "$STAGED" | grep -E '\.(js|css|html)$' || true)
if [ -n "$SW_BUMP" ] && [ -f "$SW_FILE" ]; then
  TIMESTAMP=$(date +"%Y%m%d-%H%M%S")
  NEW_NAME="madi-v5-${TIMESTAMP}"
  sed -i.bak "s/var CACHE_NAME = \"madi-v[0-9]*-[0-9]*-[0-9]*\"/var CACHE_NAME = \"${NEW_NAME}\"/" "$SW_FILE"
  rm -f "${SW_FILE}.bak"
  git add "$SW_FILE"
  echo "[pre-commit] SW 캐시 버전 갱신: ${NEW_NAME}"
fi

# ── 2. 함수 인덱스 재생성 (js/html 변경 시) ────────────────────
if [ -n "$ASSET_CHANGED" ] && [ -f "$TOPLEVEL/tools/gen-functions.js" ]; then
  node "$TOPLEVEL/tools/gen-functions.js"
  git add "$TOPLEVEL/FUNCTIONS.md"
fi

# ── 2-1. 재발 버그 패턴 권고 검사 (비차단 — CHECK_STRICT=1 이면 차단) ──
if [ -n "$ASSET_CHANGED" ] && [ -f "$TOPLEVEL/tools/check-patterns.js" ]; then
  node "$TOPLEVEL/tools/check-patterns.js" || { echo "[pre-commit] check-patterns 차단(CHECK_STRICT)"; exit 1; }
fi

# ── 2-2. 스크립트 로드 순서 계약 검증 (index.html 의 madi-*.js 의존 순서) ──
if [ -n "$ASSET_CHANGED" ] && [ -f "$TOPLEVEL/tools/check-load-order.js" ]; then
  node "$TOPLEVEL/tools/check-load-order.js"
fi

# ── 2-3. 스키마 사본 드리프트 차단 (SCHEMA.md 가 유일 정본) ──────
#   문서/브리핑에 컬럼 나열 사본 감지 시 커밋 차단 — 손사본 드리프트가
#   에이전트 오탐을 유발한 2026-06-10 전수감사 발견의 박제.
if [ -f "$TOPLEVEL/tools/check-schema-drift.js" ]; then
  node "$TOPLEVEL/tools/check-schema-drift.js"
fi

# ── 2-4. XSS 린트 우회(suppression) 증식 감시 (비차단 경고) ──────
#   eslint-disable no-unsanitized 가 늘수록 린트 게이트 보증이 줄어든다.
#   신규 추가분만 디프에서 세어 경고 — 각 라인에 사유 주석을 남길 것.
#   대상은 운영 코드(madi-*.js·html)만 — 훅/문서가 이 문자열을 인용해도 자기-매칭하지 않게.
NEW_SUPP=$(git diff --cached -U0 -- 'madi-*.js' '*.html' | grep -c '^+.*eslint-disable.*no-unsanitized' || true)
if [ "${NEW_SUPP:-0}" -gt 0 ]; then
  echo "[pre-commit] ⚠️ no-unsanitized suppression ${NEW_SUPP}건 신규 추가 — 사유 주석 필수, 가능하면 escHtml 경유로 재설계 검토"
fi

# ── 3. ESLint — 스테이징된 madi-*.js 만 (XSS 1차 방어선) ───────
STAGED_JS=$(echo "$STAGED" | grep -E '^madi-.*\.js$' || true)
if [ -n "$STAGED_JS" ] && command -v npx >/dev/null 2>&1; then
  echo "[pre-commit] ESLint 검사 중..."
  # shellcheck disable=SC2086
  npx eslint $STAGED_JS --max-warnings=0 --format=compact
  echo "[pre-commit] ESLint 통과 ✓"
fi

# ── 4. 정적 HTML 박제 차단 (.ss-wrap/.ss-input/.ss-drop) ──────
STAGED_HTML=$(echo "$STAGED" | grep -E '\.html$' || true)
if [ -n "$STAGED_HTML" ]; then
  for f in $STAGED_HTML; do
    [ -f "$TOPLEVEL/$f" ] || continue
    if grep -qE 'ss-wrap|ss-input|ss-drop' "$TOPLEVEL/$f"; then
      echo ""
      echo "[BLOCKED] 정적 HTML 박제 감지 — 커밋 취소: $f 에 런타임 DOM(.ss-*) 포함."
      echo "  → searchable select 는 <select> 골격만 두고 makeSearchable 가 런타임 래핑하도록 되돌리세요."
      exit 1
    fi
  done
  echo "[pre-commit] HTML 박제 검사 통과 ✓"
fi

# ── 5. smoke 유닛 테스트 ──────────────────────────────────────
if [ -f "$TOPLEVEL/tests/smoke.js" ]; then
  node "$TOPLEVEL/tests/smoke.js" >/dev/null && echo "[pre-commit] smoke 통과 ✓"
fi

exit 0
