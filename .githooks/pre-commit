#!/bin/sh
# ─────────────────────────────────────────────────────────────
# MADI pre-commit 훅 (버전 관리됨 — 두 PC 동기화)
#   1) 정적 자산(JS/CSS/HTML) 변경 시 sw.js CACHE_NAME 자동 갱신
#      → 캐시 버전이 바뀌어야 activate 의 구캐시 삭제 로직이 동작,
#        SWR 경로로 캐시된 구버전 JS/CSS 잔존을 방지
#   2) 스테이징된 madi-*.js ESLint (XSS no-unsanitized 차단)
#   3) smoke 유닛 테스트
#
# 설치(각 PC에서 최초 1회):  git config core.hooksPath .githooks
# ─────────────────────────────────────────────────────────────
set -e

staged=$(git diff --cached --name-only --diff-filter=ACM)

# 1) sw.js 캐시 버전 자동 갱신 — 정적 자산이 변경된 커밋에서만
asset_changed=$(echo "$staged" | grep -E '\.(js|css|html)$' | grep -v '^sw\.js$' || true)
if [ -n "$asset_changed" ] && [ -f sw.js ]; then
  ts=$(date +%Y%m%d-%H%M)
  sed -i -E "s/(CACHE_NAME = \"madi-v[0-9]+-)[0-9]{8}-[0-9]{4}(\")/\1${ts}\2/" sw.js
  git add sw.js
  echo "  [pre-commit] sw.js CACHE_NAME → madi-v5-${ts}"
fi

# 2) ESLint — 스테이징된 madi-*.js 만 (XSS 1차 방어선)
js_files=$(echo "$staged" | grep -E '^madi-.*\.js$' || true)
if [ -n "$js_files" ]; then
  npx eslint $js_files --max-warnings=0
fi

# 3) smoke 유닛 테스트
if [ -f tests/smoke.js ]; then
  node tests/smoke.js
fi
